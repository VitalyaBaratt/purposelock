# Public frontend settings. Production build pins these to the deployed contract.
VITE_NETWORK=arc
VITE_CONTRACT_ADDRESS=0xca986d006b0a07f3f31c6087cb38cdbf3aedfa0d
VITE_RPC_URL=/api/rpc
VITE_ENABLE_DEPLOYMENT=NO
# Set privately in Vercel (server-only) or ignored .env.deployment.local.
# Never prefix this with VITE_. Never commit the actual value.
ARC_MAINNET_RPC_URL=

# Client-visible Reown identifier, delivered at runtime; no wallet secret.
WALLETCONNECT_PROJECT_ID=
